#!/bin/bash
# gosvg CLI 工具集 —— 无 Web UI / 无常驻服务。
# 本哨兵仅用于满足 fnOS 应用中心的 start/stop/status 生命周期；
# 4 个 CLI 二进制位于 ${TRIM_APPDEST}/bin/，请 SSH 登录后直接调用。
#
# 进程模型：start 用 `exec` 让后台进程本身就是 sleep（PID 文件直接记它，
# 无父子 shell 分离），stop 校验进程身份后 TERM→限时等待→按需 KILL，
# status 同时校验 PID 存活 + 身份，避免陈旧 PID / PID 复用误判。
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
SENTINEL_TAG="gosvg-sentinel"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

# 校验 PID 指向的确实是本应用哨兵（防陈旧/复用误杀）
is_sentinel() {
    local pid="$1"
    [ -r "/proc/${pid}/cmdline" ] || return 1
    tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q 'sleep' || return 1
    return 0
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null && is_sentinel "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    status && return 0
    log_msg "Starting gosvg CLI sentinel (${SENTINEL_TAG}, binaries at \${TRIM_APPDEST}/bin/) ..."
    mkdir -p "${TRIM_PKGVAR}"
    # exec: 后台进程本身即 sleep，PID 文件直接记它；无父 shell 残留。
    nohup /bin/sh -c "exec sleep infinity  # ${SENTINEL_TAG}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping gosvg CLI sentinel ..."
    if [ -r "${PID_FILE}" ]; then
        local pid i
        pid=$(head -n1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && is_sentinel "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            # 限时等待退出（最多 5s）
            for i in 1 2 3 4 5; do
                kill -0 "${pid}" 2>/dev/null || break
                sleep 1
            done
            # 超时仍存活则 KILL
            if kill -0 "${pid}" 2>/dev/null; then
                kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

case "$1" in
    start)  start_process ;;
    stop)   stop_process ;;
    status) status && exit 0 || exit 3 ;;
    *)      exit 1 ;;
esac
